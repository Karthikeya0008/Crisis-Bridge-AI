# Copy to .env:  Copy-Item .env.example .env
# Every value is optional. With nothing set, the pipeline runs fully offline on the sample data.

# ---- Answer generator: auto | groq | gemini | extractive
# auto = Groq if GROQ_API_KEY is set, else Gemini if GEMINI_API_KEY is set, else extractive (no LLM)
LLM_PROVIDER=auto
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
# Groq retired llama-3.1-8b-instant and llama-3.3-70b-versatile on 16 Aug 2026; gpt-oss-20b is a production model
GROQ_MODEL=openai/gpt-oss-20b
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.1

# ---- Embeddings / vector store
# auto = sentence-transformers if installed and the model downloads, else TF-IDF+SVD (offline)
EMBEDDING_BACKEND=auto
SENTENCE_MODEL=sentence-transformers/all-MiniLM-L6-v2
# auto = FAISS if installed, else NumPy
VECTOR_STORE=auto

# ---- Live sources (all optional, each fails gracefully)
HTTP_TIMEOUT=15
# ReliefWeb needs a PRE-APPROVED appname since 1 Nov 2025: https://apidoc.reliefweb.int/parameters#appname
RELIEFWEB_APPNAME=
# Reddit "script" app: https://www.reddit.com/prefs/apps (new apps may need Reddit's approval)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=CrisisBridgeAI/0.1 by your_reddit_username
REDDIT_SUBREDDITS=india+chennai+bangalore+mumbai+naturaldisasters+TropicalWeather
# Comma-separated RSS/Atom URLs
RSS_FEEDS=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/4.5_week.atom

# ---- Optional Kaggle "NLP with Disaster Tweets" train.csv (manual download, Kaggle login required)
KAGGLE_DISASTER_CSV=data/kaggle/train.csv

LOG_LEVEL=INFO
