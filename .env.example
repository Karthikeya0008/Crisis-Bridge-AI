# Copy to .env:  Copy-Item .env.example .env
# Every value is optional. With nothing set, the pipeline runs fully offline on the sample data.

# ---- Answer generator: auto | groq | gemini | extractive
# auto = Groq if GROQ_API_KEY is set, else Gemini if GEMINI_API_KEY is set, else extractive (no LLM)
LLM_PROVIDER=auto
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
# Groq retired llama-3.1-8b-instant and llama-3.3-70b-versatile on 16 Aug 2026; gpt-oss-20b is a production model
GROQ_MODEL=openai/gpt-oss-20b
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# gemini-2.5-flash is closed to new users; gemini-3.7-flash and gemini-3.8-flash did not respond on the free tier (28 Oct 2026)
GEMINI_MODEL=gemini-3.5-flash
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.1

# ---- Embeddings / vector store
# auto = sentence-transformers if installed and the model downloads, else TF-IDF+SVD (offline)
EMBEDDING_BACKEND=auto
SENTENCE_MODEL=sentence-transformers/all-MiniLM-L6-v2
# auto = FAISS if installed, else NumPy
VECTOR_STORE=auto

# ---- Live sources (all optional, each fails gracefully)
HTTP_TIMEOUT=15
# NDMA SACHET alert feed (IMD, INCOIS, state SDMAs). Public, no key; English alerts are kept
NDMA_FEED_URL=https://sachet.ndma.gov.in/cap_public_website/rss/rss_india.xml
# Google News RSS search, no key. Comma-separated searches; the English edition of GOOGLE_NEWS_COUNTRY is used
GOOGLE_NEWS_QUERIES=flood India,cyclone India,landslide India,earthquake India,heavy rain alert India
GOOGLE_NEWS_COUNTRY=IN
# Bluesky public post search, no key. Handle + app password (bsky.app > Settings > App passwords) are only
# used if Bluesky refuses search without a login
BLUESKY_QUERIES=flood India,cyclone India,landslide India,earthquake India,trapped rescue flood
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
# Indian newspaper RSS, no key; only stories that mention a disaster are kept
INDIA_NEWS_FEEDS=https://www.thehindu.com/news/national/feeder/default.rss,https://feeds.feedburner.com/ndtvnews-india-news,https://timesofindia.indiatimes.com/rssfeeds/-2128936835.cms,https://indianexpress.com/section/india/feed/
# Mastodon public hashtag timelines, no key
MASTODON_INSTANCE=https://mastodon.social
MASTODON_TAGS=flood,floods,flooding,cyclone,earthquake,landslide
# Area for NASA EONET events and EMSC earthquakes: min_lon,min_lat,max_lon,max_lat (empty = worldwide)
REGION_BBOX=60,0,100,40
EMSC_MIN_MAGNITUDE=3.0
# ReliefWeb needs a PRE-APPROVED appname since 1 Nov 2025: https://apidoc.reliefweb.int/parameters#appname
RELIEFWEB_APPNAME=
# Reddit "script" app: https://www.reddit.com/prefs/apps (new apps may need Reddit's approval)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=CrisisBridgeAI/0.1 by your_reddit_username
REDDIT_SUBREDDITS=india+chennai+bangalore+mumbai+naturaldisasters+TropicalWeather
# Comma-separated RSS/Atom URLs
RSS_FEEDS=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/4.5_week.atom

# ---- Optional Kaggle "NLP with Disaster Tweets" train.csv (manual download, Kaggle login required)
KAGGLE_DISASTER_CSV=data/kaggle/train.csv

LOG_LEVEL=INFO
